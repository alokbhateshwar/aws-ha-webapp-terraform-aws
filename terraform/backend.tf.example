# OPTIONAL: remote state (recommended for teams).
# 1. Create an S3 bucket (versioning + encryption on) and a DynamoDB table
#    with partition key "LockID" (String).
# 2. Rename this file to backend.tf and fill in the values.
# 3. Run: terraform init -migrate-state

terraform {
  backend "s3" {
    bucket         = "my-terraform-state-bucket"
    key            = "ha-webapp/dev/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
